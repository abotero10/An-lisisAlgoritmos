class Solution:
    def minCostClimbingStairs(self, cost):
        """
        Calcula el coste mínimo para llegar a la cima de la escalera.

        Usa programación dinámica donde dp[i] representa el coste mínimo
        para llegar al escalón i. En cada paso se puede venir desde i-1 o i-2.

        Complejidad:
        - Tiempo: O(n)
        - Espacio: O(1)
        """
        n = len(cost)

        prev2 = 0  # dp[i-2]
        prev1 = 0  # dp[i-1]

        for i in range(2, n + 1):
            current = min(prev1 + cost[i - 1], prev2 + cost[i - 2])
            prev2 = prev1
            prev1 = current

        return prev1
