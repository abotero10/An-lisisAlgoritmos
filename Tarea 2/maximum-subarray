class Solution:
    def maxSubArray(self, nums: list[int]) -> int:
        """
        Calcula la suma máxima de una sublista contigua dentro de la lista dada.

        Utiliza el algoritmo de Kadane:
        - Recorre la lista manteniendo la suma actual de la sublista contigua.
        - Decide en cada paso si conviene continuar sumando o empezar de nuevo.
        - Mantiene un registro de la suma máxima encontrada hasta el momento.

        Retorna:
        int: La suma máxima de cualquier sublista contigua dentro de `nums`.
        """
        suma_actual = suma_maxima = nums[0]
        
        for i in range(1, len(nums)):
            num = nums[i]
            
            if suma_actual + num > num:
                suma_actual = suma_actual + num
            else:
                suma_actual = num
            
            if suma_actual > suma_maxima:
                suma_maxima = suma_actual
                
        return suma_maxima
